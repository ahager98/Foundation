<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- GitHub Packages feed for Foundation packages. Authentication uses GITHUB_TOKEN / PAT
         set in the environment (NEVER hard-code credentials here — this file is committed).
         packageSourceMapping below restricts this feed to Foundation.* packages only, so standard
         NuGet packages never trigger a GitHub auth attempt. -->
    <add key="github-ahager98" value="https://nuget.pkg.github.com/ahager98/index.json" />
  </packageSources>

  <packageSourceCredentials>
    <github-ahager98>
      <add key="Username" value="%GITHUB_ACTOR%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github-ahager98>
  </packageSourceCredentials>

  <!-- Only Foundation.* packages are resolved from the GitHub feed; everything else comes from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github-ahager98">
      <package pattern="Foundation.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
