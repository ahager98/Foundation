<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Foundation.Caching</PackageId>
    <Description>HybridCache helpers for services: the AddFoundationCaching IServiceCollection extension (Redis L2 + HybridCache wiring) and WriteThroughCache&lt;T&gt;, a tenant- and sub-scope-scoped write-through cache whose every write evicts, with per-scope bounds and a short TTL for classified data.</Description>
    <RootNamespace>Foundation.Caching</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Foundation.Caching.Tests" />
  </ItemGroup>

</Project>
